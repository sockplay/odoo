<odoo>
    <!-- Form View -->
    <record id="view_real_estate_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="expected_price"/>
                        <field name="selling_price"/>
                        <field name="bedrooms"/>
                        <field name="living_area"/>
                        <field name="total_area" readonly="1"/>
                        <field name="state" widget="statusbar"/>
                    </group>
                    <footer>
                        <button name="action_sold" string="Sell" type="object" class="btn-primary" odoo-condition="state not in ('sold', 'canceled')"/>
                        <button name="action_cancel" string="Cancel" type="object"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_real_estate_property_tree" model="ir.ui.view">
        <field name="name">real.estate.property.tree</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
</odoo>
